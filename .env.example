# ─── Telegram ───────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
ADMIN_ID=123456789
API_ID=12345678
API_HASH=your_api_hash_here

# Optional: Local Telegram Bot API Server (Docker — Pyrogram does not need this)
LOCAL_API_SERVER_URL=http://localhost:8081

# ─── Force-Join Channels ────────────────────────────────────────────────────
FORCE_JOIN_CHANNEL_1=@webdw
FORCE_JOIN_CHANNEL_2=@webdwCF

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///bot.db
# PostgreSQL (uncomment & fill):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/drivebot

# ─── Google OAuth2 ── REQUIRED ──────────────────────────────────────────────
# Every user authenticates their own personal Google Drive (15 GB).
# See GOOGLE_SETUP.md for step-by-step instructions.
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
# Must match EXACTLY what you added in Google Cloud Console → Authorized Redirect URIs
GOOGLE_OAUTH_REDIRECT_URI=http://localhost

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_MAX_UPLOADS=3
RATE_LIMIT_WINDOW_SECONDS=60
