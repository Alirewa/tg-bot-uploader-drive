#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# tgdrive — Management CLI for Google Drive Uploader Bot
# Install: sudo cp tgdrive /usr/local/bin/tgdrive && sudo chmod +x /usr/local/bin/tgdrive
# ─────────────────────────────────────────────────────────────────────────────

INSTALL_DIR="/opt/gdrive-uploader-bot"
SERVICE="gdrive-uploader"
ENV_FILE="${INSTALL_DIR}/.env"
VENV="${INSTALL_DIR}/.venv"
REPO_DIR="${TGDRIVE_REPO:-$HOME/tg-bot-uploader-drive}"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

_ok()   { echo -e "${GREEN}✔${NC}  $*"; }
_err()  { echo -e "${RED}✘${NC}  $*"; }
_info() { echo -e "${CYAN}→${NC}  $*"; }

_require_root() {
    [[ $EUID -ne 0 ]] && { _err "Run with sudo: sudo tgdrive $1"; exit 1; }
}

_status_line() {
    if systemctl is-active --quiet "$SERVICE"; then
        echo -e "  Status:  ${GREEN}● running${NC}"
    else
        echo -e "  Status:  ${RED}● stopped${NC}"
    fi
}

case "${1:-help}" in

# ── status ────────────────────────────────────────────────────────────────────
status)
    echo -e "\n${BOLD}── gdrive-uploader status ──${NC}"
    _status_line
    echo ""
    systemctl status "$SERVICE" --no-pager -l
    ;;

# ── start ─────────────────────────────────────────────────────────────────────
start)
    _require_root start
    systemctl start "$SERVICE"
    sleep 2
    if systemctl is-active --quiet "$SERVICE"; then
        _ok "Bot started."
    else
        _err "Failed to start. Run: sudo tgdrive logs"
    fi
    ;;

# ── stop ──────────────────────────────────────────────────────────────────────
stop)
    _require_root stop
    systemctl stop "$SERVICE"
    _ok "Bot stopped."
    ;;

# ── restart ───────────────────────────────────────────────────────────────────
restart)
    _require_root restart
    systemctl restart "$SERVICE"
    sleep 2
    if systemctl is-active --quiet "$SERVICE"; then
        _ok "Bot restarted."
    else
        _err "Restart failed. Run: sudo tgdrive logs"
    fi
    ;;

# ── logs ──────────────────────────────────────────────────────────────────────
logs)
    # live logs (Ctrl+C to exit)
    journalctl -u "$SERVICE" -f --no-pager
    ;;

logs-n)
    # last N lines (default 50)
    journalctl -u "$SERVICE" -n "${2:-50}" --no-pager
    ;;

# ── env ───────────────────────────────────────────────────────────────────────
env)
    _require_root env
    if [[ ! -f "$ENV_FILE" ]]; then
        _err ".env file not found at $ENV_FILE"
        exit 1
    fi
    echo -e "${YELLOW}Opening .env — bot will restart after you save.${NC}"
    sleep 1
    nano "$ENV_FILE"
    echo ""
    read -rp "Restart bot now? [Y/n]: " CONFIRM
    [[ "${CONFIRM:-Y}" =~ ^[Yy]$ ]] && systemctl restart "$SERVICE" && _ok "Bot restarted."
    ;;

# ── env-show ──────────────────────────────────────────────────────────────────
env-show)
    _require_root env-show
    echo -e "\n${BOLD}── Current .env ──${NC}"
    grep -v "^#" "$ENV_FILE" | grep -v "^$" | \
        sed 's/\(SECRET\|HASH\|TOKEN\|PASSWORD\)=\(.\{4\}\).*/\1=\2***/'
    echo ""
    ;;

# ── env-set ───────────────────────────────────────────────────────────────────
env-set)
    # Usage: sudo tgdrive env-set KEY VALUE
    _require_root env-set
    [[ -z "$2" || -z "$3" ]] && { _err "Usage: sudo tgdrive env-set KEY VALUE"; exit 1; }
    KEY="$2"; VAL="$3"
    if grep -q "^${KEY}=" "$ENV_FILE"; then
        sed -i "s|^${KEY}=.*|${KEY}=${VAL}|" "$ENV_FILE"
        _ok "Updated ${KEY} in .env"
    else
        echo "${KEY}=${VAL}" >> "$ENV_FILE"
        _ok "Added ${KEY} to .env"
    fi
    read -rp "Restart bot now? [Y/n]: " CONFIRM
    [[ "${CONFIRM:-Y}" =~ ^[Yy]$ ]] && systemctl restart "$SERVICE" && _ok "Restarted."
    ;;

# ── update ────────────────────────────────────────────────────────────────────
update)
    _require_root update
    echo -e "\n${BOLD}── Updating bot ──${NC}"

    # Find repo — check common locations
    REPO=""
    for candidate in "$REPO_DIR" "$HOME/tg-bot-uploader-drive" /root/tg-bot-uploader-drive; do
        [[ -d "$candidate/.git" ]] && { REPO="$candidate"; break; }
    done

    if [[ -z "$REPO" ]]; then
        _err "Git repo not found. Set it with:"
        echo "    export TGDRIVE_REPO=/path/to/tg-bot-uploader-drive"
        echo "    sudo -E tgdrive update"
        exit 1
    fi

    _info "Pulling latest code from GitHub..."
    git -C "$REPO" pull origin main

    _info "Syncing files to ${INSTALL_DIR}..."
    rsync -a \
        --exclude='.git' --exclude='.venv' --exclude='__pycache__' \
        --exclude='*.session' --exclude='*.db' --exclude='.env' \
        --exclude='temp/' \
        "${REPO}/" "${INSTALL_DIR}/"

    _info "Updating Python dependencies..."
    "${VENV}/bin/pip" install -r "${INSTALL_DIR}/requirements.txt" -q

    _info "Restarting service..."
    systemctl restart "$SERVICE"
    sleep 2

    if systemctl is-active --quiet "$SERVICE"; then
        _ok "Bot updated and running!"
    else
        _err "Bot failed to start after update. Check: sudo tgdrive logs"
    fi
    ;;

# ── info ──────────────────────────────────────────────────────────────────────
info)
    echo -e "\n${BOLD}── Bot Info ──────────────────────────${NC}"
    _status_line
    echo -e "  Install:  ${CYAN}${INSTALL_DIR}${NC}"
    echo -e "  Service:  ${CYAN}${SERVICE}.service${NC}"
    echo -e "  Venv:     ${CYAN}${VENV}${NC}"
    echo -e "  Env:      ${CYAN}${ENV_FILE}${NC}"
    if [[ -f "${INSTALL_DIR}/bot.db" ]]; then
        DB_SIZE=$(du -sh "${INSTALL_DIR}/bot.db" 2>/dev/null | cut -f1)
        echo -e "  DB size:  ${CYAN}${DB_SIZE}${NC}"
    fi
    if systemctl is-active --quiet "$SERVICE"; then
        PID=$(systemctl show -p MainPID "$SERVICE" | cut -d= -f2)
        MEM=$(ps -o rss= -p "$PID" 2>/dev/null | awk '{printf "%.1f MB", $1/1024}')
        echo -e "  Memory:   ${CYAN}${MEM}${NC}"
    fi
    echo ""
    ;;

# ── help ──────────────────────────────────────────────────────────────────────
help|--help|-h|*)
    echo -e "
${BOLD}tgdrive${NC} — Google Drive Uploader Bot Manager

${BOLD}USAGE${NC}
  tgdrive <command> [args]

${BOLD}COMMANDS${NC}
  ${GREEN}status${NC}              Show service status
  ${GREEN}start${NC}               Start the bot
  ${GREEN}stop${NC}                Stop the bot
  ${GREEN}restart${NC}             Restart the bot
  ${GREEN}logs${NC}                Live log stream (Ctrl+C to exit)
  ${GREEN}logs-n [N]${NC}          Show last N log lines (default: 50)
  ${GREEN}info${NC}                Show install path, memory, DB size

  ${GREEN}env${NC}                 Open .env in nano editor + restart
  ${GREEN}env-show${NC}            Print .env (secrets masked)
  ${GREEN}env-set KEY VALUE${NC}   Update a single .env key + restart

  ${GREEN}update${NC}              git pull + sync files + restart

${BOLD}EXAMPLES${NC}
  sudo tgdrive restart
  sudo tgdrive logs-n 100
  sudo tgdrive env-set BOT_TOKEN 123456:ABC-xyz
  sudo tgdrive update
"
    ;;

esac
